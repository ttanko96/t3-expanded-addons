# The TMST add-on in the Expanded's own add-on hook (TEKKEN3_ADDON_API 1,
# the Expanded's MODDING.md "Add-ons"): included from addon.cmake, in the
# Expanded's CMakeLists, with addon.cmake's lists set. Everything
# dev/tmst_inject.cmake did, through the hook's functions: no
# CMAKE_PROJECT_INCLUDE, no objcopy, nothing left behind once the folder is
# gone.

set(TMST_DIR "${TEKKEN3_ADDON_DIR}")
# Seen by dev/tmst_inject.cmake (an old cache's CMAKE_PROJECT_INCLUDE): the
# add-on is built in once.
set_property(GLOBAL PROPERTY TMST_ADDON_HOOK 1)
set(_sources "")
foreach(_s IN LISTS TMST_SOURCES)
    list(APPEND _sources "${TMST_DIR}/${_s}")
endforeach()
set(_includes "")
foreach(_i IN LISTS TMST_INCLUDE_DIRS)
    list(APPEND _includes "${TMST_DIR}/${_i}")
endforeach()
target_sources(psx-runtime PRIVATE ${_sources})
execute_process(COMMAND git -C "${CMAKE_SOURCE_DIR}" describe --tags --always
    OUTPUT_VARIABLE _rev OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT _rev)
    set(_rev "unknown")
endif()
include("${TMST_DIR}/src/compat/tmst_features.cmake")
tmst_detect_features(_features)
set_source_files_properties(${_sources} PROPERTIES
    INCLUDE_DIRECTORIES "${_includes}"
    COMPILE_DEFINITIONS "TMST_VERSION=\"${TMST_VERSION}\";TMST_UPSTREAM_REV=\"${_rev}\";TMST_TESTED_WITH=\"${TMST_TESTED_WITH}\";${_features}")

# "symbol|file[|FEATURE]": the entry, or empty when FEATURE is missing.
function(_tmst_entry entry out_sym out_file)
    string(REPLACE "|" ";" _parts "${entry}")
    list(GET _parts 0 _sym)
    list(GET _parts 1 _file)
    list(LENGTH _parts _n)
    if(_n GREATER 2)
        list(GET _parts 2 _need)
        if(NOT "TMST_HAS_${_need}=1" IN_LIST _features)
            message(STATUS "TMST: no ${_need} in this Expanded, ${_sym} left alone")
            set(_sym "")
        endif()
    endif()
    set(${out_sym} "${_sym}" PARENT_SCOPE)
    set(${out_file} "${TMST_DIR}/${_file}" PARENT_SCOPE)
endfunction()

foreach(_w IN LISTS TMST_WRAPS)
    _tmst_entry("${_w}" _sym _file)
    if(_sym)
        tekken3_wrap_symbol(${_sym} WRAPPER "${_file}")
    endif()
endforeach()
set(_bridges "")
set(_seen "")
# macOS: a system function (fopen) has no definition to rename; the
# Expanded's sources that call it include a header sending them to ours
# (TMST_APPLE_CALLERS), and ours reaches the system's under its own name.
set(_apple_callers "")
if(APPLE)
    # The game's own wraps (1.4.1 named the property TEKKEN3_WRAP_SYMS).
    get_property(_game_wraps GLOBAL PROPERTY TEKKEN3_WRAPPED_SYMS)
    get_property(_game_wraps_old GLOBAL PROPERTY TEKKEN3_WRAP_SYMS)
    list(APPEND _game_wraps ${_game_wraps_old})
    foreach(_a IN LISTS TMST_APPLE_CALLERS)
        string(REPLACE "|" ";" _parts "${_a}")
        list(GET _parts 0 _sym)
        if(NOT _sym IN_LIST _game_wraps)
            list(APPEND _apple_callers "${_a}")
        endif()
    endforeach()
endif()
foreach(_c IN LISTS TMST_CHAINS)
    _tmst_entry("${_c}" _sym _file)
    if(NOT _sym OR _sym IN_LIST _seen)
        continue()
    endif()
    list(APPEND _seen ${_sym})
    set(_redirected FALSE)
    foreach(_a IN LISTS _apple_callers)
        string(REPLACE "|" ";" _parts "${_a}")
        list(GET _parts 0 _asym)
        if(_asym STREQUAL _sym)
            list(GET _parts 1 _caller)
            list(GET _parts 2 _header)
            set_property(SOURCE "${CMAKE_SOURCE_DIR}/${_caller}" APPEND PROPERTY
                COMPILE_OPTIONS "-include" "${TMST_DIR}/${_header}")
            set_property(SOURCE "${_file}" APPEND PROPERTY COMPILE_DEFINITIONS "__real_${_sym}=${_sym}")
            set(_redirected TRUE)
        endif()
    endforeach()
    if(_redirected)
        list(APPEND _bridges "TMST_BRIDGE_${_sym}=1")
        continue()
    endif()
    tekken3_addon_chain(${_sym} WRAPPER "${_file}" CHAIN "__tmst_chain_${_sym}" BRIDGED _bridged)
    if(_bridged)
        list(APPEND _bridges "TMST_BRIDGE_${_sym}=1")
    endif()
endforeach()
if(_bridges)
    set_property(SOURCE ${_sources} APPEND PROPERTY COMPILE_DEFINITIONS ${_bridges})
endif()

foreach(_p IN LISTS TMST_PACKAGES)
    tekken3_addon_stage(FROM "${TMST_DIR}/mods/${_p}" TO "mods/packages/${_p}")
endforeach()
foreach(_s IN LISTS TMST_STAGED)
    string(REPLACE "|" ";" _parts "${_s}")
    list(GET _parts 0 _from)
    list(GET _parts 1 _to)
    tekken3_addon_stage(FROM "${TMST_DIR}/${_from}" TO "${_to}")
endforeach()
message(STATUS "TMST ${TMST_VERSION} (add-on hook ${TEKKEN3_ADDON_API}): at ${_rev}; features: ${_features}")
